---
import "@fontsource-variable/inter";
import { getCV, resolveLocale } from "@cv";
import { useTranslations } from "@/i18n";

interface Props {
  title: string;
}

const { title } = Astro.props;

const locale = resolveLocale(Astro.currentLocale);
const t = useTranslations(locale);
const { image, summary } = getCV(locale).basics;

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const paths = { es: `${base}/`, en: `${base}/en/` };
const otherLocale = locale === "es" ? "en" : "es";

// Absolute URLs are only available when the `site` option is configured.
const absolute = (pathname: string) => (Astro.site ? new URL(pathname, Astro.site).href : undefined);
const canonical = absolute(paths[locale]);
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <title>{title}</title>
    <meta name="description" content={summary} />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      // Apply the saved theme before first paint to avoid a flash.
      try {
        if (localStorage.getItem("theme") === "dark") document.documentElement.dataset.theme = "dark";
      } catch {}
    </script>
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
    {canonical && <link rel="canonical" href={canonical} />}
    {canonical && <link rel="alternate" hreflang="es" href={absolute(paths.es)} />}
    {canonical && <link rel="alternate" hreflang="en" href={absolute(paths.en)} />}

    {canonical && <meta property="og:url" content={canonical} />}
    <meta property="og:type" content="profile" />
    <meta property="og:locale" content={locale === "es" ? "es_BO" : "en_US"} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={summary} />
    <meta property="og:image" content={image} />

    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={summary} />
    <meta name="twitter:image" content={image} />
  </head>
  <body>
    <div class="background-pattern"></div>
    <div class="page-controls no-print">
      <button id="theme-toggle" type="button" title={t.toggleTheme} aria-label={t.toggleTheme} aria-pressed="false">
        <svg class="icon-moon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9z"></path>
        </svg>
        <svg class="icon-sun" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="12" cy="12" r="4"></circle>
          <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"></path>
        </svg>
      </button>
      <a href={paths[otherLocale]} hreflang={otherLocale} lang={otherLocale} title={t.switchLanguage} aria-label={t.switchLanguage}>
        {t.switchLanguageShort}
      </a>
    </div>
    <slot />
  </body>
</html>

<script>
  const root = document.documentElement;
  const toggle = document.getElementById("theme-toggle");

  const syncTheme = () => {
    const isDark = root.dataset.theme === "dark";
    toggle?.setAttribute("aria-pressed", String(isDark));
    document.getElementById("hotkeypad")?.classList.toggle("dark", isDark);
  };

  toggle?.addEventListener("click", () => {
    const isDark = root.dataset.theme === "dark";
    if (isDark) delete root.dataset.theme;
    else root.dataset.theme = "dark";
    try {
      localStorage.setItem("theme", isDark ? "light" : "dark");
    } catch {}
    syncTheme();
  });

  syncTheme();
</script>

<style is:global>
  :root {
    color-scheme: light;
    --color-heading: #111827;
    --color-text: #1f2937;
    --color-text-soft: #4b5563;
    --color-text-muted: #6b7280;
    --color-bg: #ffffff;
    --color-surface: #ffffff;
    --color-surface-hover: #f3f4f6;
    --color-primary: #2563eb;
    --color-accent: #3b82f6;
    --color-success: #10b981;
    --color-border: #e5e7eb;
    --color-border-strong: #d1d5db;
    --color-chip-bg: #1f2937;
    --color-chip-bg-hover: #374151;
    --color-chip-text: #ffffff;
    --color-pattern: #e5e7eb;
    --shadow-card: 0 10px 15px -3px rgba(0, 0, 0, 0.1), 0 4px 6px -2px rgba(0, 0, 0, 0.05);
    --font-sans: 'Inter Variable', 'Inter', system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, 'Open Sans', 'Helvetica Neue', sans-serif;
  }

  :root[data-theme="dark"] {
      color-scheme: dark;
      --color-heading: #f9fafb;
      --color-text: #e5e7eb;
      --color-text-soft: #c4c9d2;
      --color-text-muted: #9ca3af;
      --color-bg: #0b0f17;
      --color-surface: #131a26;
      --color-surface-hover: #1c2534;
      --color-primary: #60a5fa;
      --color-accent: #60a5fa;
      --color-success: #34d399;
      --color-border: #232d3d;
      --color-border-strong: #364357;
      --color-chip-bg: #1c2534;
      --color-chip-bg-hover: #2a3649;
      --color-chip-text: #e5e7eb;
      --color-pattern: #1e2735;
      --shadow-card: 0 10px 15px -3px rgba(0, 0, 0, 0.5), 0 4px 6px -2px rgba(0, 0, 0, 0.3);
  }

  html {
    font-family: var(--font-sans);
    background: var(--color-bg);
    letter-spacing: -0.025rem;
    color: var(--color-text);
  }

  body,
  figure {
    margin: 0;
    padding: 0;
  }

  a {
    text-decoration: none;
    color: inherit;
    transition: color 0.2s ease;
  }

  ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }

  h1, h2, h3, h4 {
    margin: 0;
    font-family: var(--font-sans);
    color: var(--color-heading);
  }

  p {
    color: var(--color-text-muted);
    font-size: 0.95rem;
    line-height: 1.6;
    margin: 0;
    text-wrap: pretty;
  }

  .background-pattern {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: -1;
    background-image: radial-gradient(var(--color-pattern) 1px, transparent 1px);
    background-size: 24px 24px;
    opacity: 0.6;
    pointer-events: none;
    mask-image: linear-gradient(to bottom, black 60%, transparent 100%);
  }

  .page-controls {
    position: absolute;
    top: 1rem;
    right: 1rem;
    display: flex;
    gap: 6px;
  }

  .page-controls > * {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: 28px;
    min-width: 32px;
    padding: 0 8px;
    font-family: inherit;
    cursor: pointer;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.02rem;
    color: var(--color-text-muted);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 6px;
  }

  .page-controls > *:hover {
    color: var(--color-heading);
    border-color: var(--color-border-strong);
    background: var(--color-surface-hover);
  }

  .icon-sun,
  :root[data-theme="dark"] .icon-moon {
    display: none;
  }

  :root[data-theme="dark"] .icon-sun {
    display: block;
  }

  :focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 2px;
    border-radius: 4px;
  }

  .print {
    display: none !important;
  }

  @media print {
    :root,
    :root[data-theme="dark"] {
      color-scheme: light;
      --color-heading: #111827;
      --color-text: #1f2937;
      --color-text-soft: #4b5563;
      --color-text-muted: #6b7280;
      --color-bg: #ffffff;
      --color-surface: #ffffff;
      --color-border: #e5e7eb;
      --color-accent: #3b82f6;
    }

    .no-print {
      display: none !important;
    }

    .background-pattern {
      display: none;
    }

    body {
      margin: 0;
      background: white;
    }

    .print {
      display: block !important;
    }

    astro-dev-toolbar {
      display: none !important;
    }

    article {
      break-inside: avoid;
    }
  }
</style>
