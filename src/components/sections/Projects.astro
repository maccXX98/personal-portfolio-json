---
import GitHub from "@/icons/GitHub.astro";
import Section from "../Section.astro";

import { getCV } from "@cv";
import { useTranslations } from "@/i18n";

const { projects } = getCV(Astro.currentLocale);
const t = useTranslations(Astro.currentLocale);
---

<Section title={t.projects}>
  <ul class="grid">
    {
      projects.map(({ url, description, highlights, name, isActive, github }) => {
        return (
          <li>
            <article>
              <header>
                <h3>
                  {url ? (
                    <a href={url} target="_blank" rel="noopener noreferrer" title={t.viewProject(name)}>
                      {name}
                    </a>
                  ) : (
                    name
                  )}
                  {isActive && <span class="active" title={t.activeProject} aria-label={t.activeProject}>{" "}•</span>}
                  {github && github !== url && (
                    <a
                      class="github-code-link"
                      href={github}
                      target="_blank"
                      rel="noopener noreferrer"
                      title={t.viewSource(name)}
                      aria-label={t.viewSource(name)}
                    >
                      <GitHub />
                    </a>
                  )}
                </h3>
                <p>{description}</p>
              </header>
              <ul class="highlights">
                {highlights.map((highlight) => (
                  <li>{highlight}</li>
                ))}
              </ul>
            </article>
          </li>
        );
      })
    }
  </ul>
</Section>

<style>
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 1rem;
    margin-inline: -16px;
  }

  article {
    border-radius: 8px;
    border: 1px solid var(--color-border);
    gap: 12px;
    display: flex;
    flex-direction: column;
    padding: 16px;
    height: 100%;
    background: var(--color-surface);
    transition: all 0.3s ease;
  }
  
  article:hover {
    transform: translateY(-5px);
    box-shadow: var(--shadow-card);
    border-color: var(--color-border-strong);
  }

  article h3 {
    margin-bottom: 4px;
    font-weight: 600;
    color: var(--color-heading);
  }

  article a {
    color: inherit;
  }

  article a:hover {
    text-decoration: underline;
    color: var(--color-primary);
  }

  article p {
    font-size: 0.85rem;
    line-height: 1.5;
    margin-bottom: 4px;
    color: var(--color-text-soft);
  }

  article h3 .active {
    color: var(--color-success);
    animation-name: flicker;
    animation-duration: 3s;
    animation-timing-function: ease-in;
    animation-iteration-count: infinite;
  }

  .highlights {
    list-style: disc;
    padding-left: 1.1rem;
    display: flex;
    flex-direction: column;
    gap: 4px;
    color: var(--color-text-soft);
    font-size: 0.8rem;
    line-height: 1.45;
  }

  .highlights li::marker {
    color: var(--color-accent);
  }

  .github-code-link {
    margin-left: 5px;
    display: inline-flex;
    vertical-align: middle;
    white-space: nowrap;
  }

  @keyframes flicker {
    0% { opacity: 1; }
    50% { opacity: 0.25; }
    100% { opacity: 1; }
  }

  @media (width <= 700px) {
    .grid {
      margin-inline: 0px;
    }

    article {
      border: none;
      box-shadow: none;
      background: transparent;
      padding: 0 0 16px 0;
    }
  }

  @media print {
    article h3 .active {
      animation-name: none;
    }
  }
</style>
