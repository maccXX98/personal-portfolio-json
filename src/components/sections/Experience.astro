---
import Section from "../Section.astro";

import { getCV } from "@cv";
import { formatMonthYear, useTranslations } from "@/i18n";

const locale = Astro.currentLocale;
const { work } = getCV(locale);
const t = useTranslations(locale);
---

<Section title={t.experience}>
  <ul class="timeline">
    {
      work.map(({ name, startDate, endDate, position, summary, url, highlights }) => {
        const start = formatMonthYear(startDate, locale);
        const end = endDate ? formatMonthYear(endDate, locale) : t.present;

        return (
          <li>
            <article>
              <header>
                <div>
                  <h3>
                    {url ? (
                      <a href={url} title={t.viewCompany(name)} target="_blank" rel="noopener noreferrer">
                        {name}
                      </a>
                    ) : (
                      name
                    )}
                  </h3>
                  <h4>{position}</h4>
                </div>

                <div class="period">
                  <time datetime={startDate}>{start}</time>
                  {" – "}
                  {endDate ? <time datetime={endDate}>{end}</time> : <span>{end}</span>}
                </div>
              </header>

              <footer>
                <p>{summary}</p>
                {highlights?.length > 0 && (
                  <ul class="highlights">
                    {highlights.map((highlight) => (
                      <li>{highlight}</li>
                    ))}
                  </ul>
                )}
              </footer>
            </article>
          </li>
        );
      })
    }
  </ul>
</Section>

<style>
  .timeline {
    display: flex;
    flex-direction: column;
    gap: 32px;
    position: relative;
    padding-left: 1.5rem;
  }
  
  .timeline::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 2px;
    background: var(--color-border);
  }

  .timeline > li {
    position: relative;
  }

  .timeline > li::before {
    content: '';
    position: absolute;
    left: -1.5rem;
    top: 0.5rem;
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--color-accent);
    border: 2px solid var(--color-bg);
    transform: translateX(-50%);
    z-index: 1;
  }

  article h3 {
    font-weight: 600;
    color: var(--color-heading);
    font-size: 1.1rem;
  }

  article a {
    color: inherit;
  }

  article a:hover {
    text-decoration: underline;
    color: var(--color-primary);
  }

  article h4 {
    color: var(--color-text-soft);
    font-weight: 400;
    margin-top: 0.25rem;
  }

  header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 8px;
  }

  .period {
    color: var(--color-text-muted);
    font-size: 0.85rem;
    white-space: nowrap;
    padding-left: 1rem;
    padding-top: 0.2rem;
  }

  .highlights {
    list-style: disc;
    margin-top: 8px;
    padding-left: 1.1rem;
    display: flex;
    flex-direction: column;
    gap: 4px;
    color: var(--color-text-soft);
    font-size: 0.9rem;
    line-height: 1.5;
  }

  .highlights li::marker {
    color: var(--color-accent);
  }

  p {
    color: var(--color-text-soft);
  }

  @media (width <= 700px) {
    .timeline {
      padding-left: 0;
    }
    
    .timeline::before, .timeline > li::before {
      display: none;
    }
  }

  @media print {
    .timeline::before, .timeline > li::before {
      -webkit-print-color-adjust: exact;
      print-color-adjust: exact;
    }
  }
</style>
