---
import { getCV } from "@cv";
import { useTranslations } from "@/i18n";
import Section from "@/components/Section.astro";
import Mail from "@/icons/Mail.astro";
import Phone from "@/icons/Phone.astro";
import LinkedIn from "@/icons/LinkedIn.astro";
import GitHub from "@/icons/GitHub.astro";
import WorldMap from "@/icons/WorldMap.astro";
import type { SocialIcon } from "@/types";

const { basics } = getCV(Astro.currentLocale);
const t = useTranslations(Astro.currentLocale);

const { name, label, image, location, profiles, phone, email } = basics;
const { city, region } = location;

const SOCIAL_ICONS: SocialIcon = {
  GitHub,
  LinkedIn,
};

const linkedInfo = profiles.find(({ network }) => network === "LinkedIn");
const linkedUrl = linkedInfo?.url;

const printInfo = [email, phone, linkedUrl].filter(Boolean).join(" • ");

import { Picture } from "astro:assets";
---

<Section>
  <div class="container">
    <div class="info">
      <h1>{name}</h1>
      <p class="label">{label}</p>
      <span>
        <WorldMap />
        {city}, {region}
      </span>
      <footer class="print">
        {printInfo}
      </footer>
      <footer class="no-print">
        {
          email && (
            <a
              href={`mailto:${email}`}
              title={t.sendEmail(name, email)}
              aria-label={t.sendEmail(name, email)}
            >
              <Mail />
            </a>
          )
        }
        {
          phone && (
            <a
              href={`tel:${phone}`}
              title={t.call(name, phone)}
              aria-label={t.call(name, phone)}
            >
              <Phone />
            </a>
          )
        }
        {
          profiles.map(({ network, url }) => {
            const Icon = SOCIAL_ICONS[network];

            return (
              <a
                href={url}
                title={t.visitProfile(name, network)}
                aria-label={t.visitProfile(name, network)}
                target="_blank"
                rel="noopener noreferrer"
              >
                {Icon && <Icon />}
              </a>
            );
          })
        }
      </footer>
    </div>
    <figure>
      <Picture src={image} alt={name} loading="eager" formats={["avif", "webp", "jpg"]} width={165} height={165} densities={[1, 2]} />
    </figure>
  </div>
</Section>

<style>
  .container {
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .info {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding-right: 32px;
  }

  h1 {
    font-size: 2.5rem;
    font-weight: 800;
    letter-spacing: -0.05rem;
    line-height: 1.1;
  }

  .label {
    color: var(--color-text-soft);
    font-weight: 500;
    font-size: 1.1rem;
    text-wrap: balance;
  }

  img {
    aspect-ratio: 1 / 1;
    object-fit: cover;
    width: 165px;
    height: 165px;
    border-radius: 16px;
    box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06);
    transform: rotate(3deg);
    transition: transform 0.3s ease;
  }
  
  img:hover {
    transform: rotate(0deg) scale(1.05);
  }

  span {
    color: var(--color-text-muted);
    display: flex;
    align-items: center;
    gap: 0.25rem;
    font-size: 0.85rem;
    letter-spacing: -0.05rem;
  }

  footer {
    color: var(--color-text-muted);
    font-size: 0.65rem;
    display: flex;
    gap: 4px;
    margin-top: 8px;
  }

  footer a {
    color: var(--color-text-muted);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--color-border);
    padding: 4px;
    height: 32px;
    width: 32px;
    border-radius: 6px;
    transition: all 0.3s ease;
  }

  footer a:hover {
    background: var(--color-surface-hover);
    border-color: var(--color-border-strong);
    color: var(--color-heading);
    transform: translateY(-2px);
  }

  @media (width <= 700px) {
    .container {
      flex-direction: column-reverse;
    }

    .info {
      justify-content: center;
      align-items: center;
      padding-right: 0;
      text-align: center;
    }

    figure {
      display: flex;
      justify-content: center;
      align-items: center;
    }

    figure {
      margin: 0 auto;
    }
  }

  @media print {
    img {
      width: 165px;
      height: 165px;
      transform: none;
      box-shadow: none;
    }
  }
</style>
