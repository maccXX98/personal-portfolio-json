---
import Section from "../Section.astro";
import HTML from "@/icons/html.astro";
import CSS from "@/icons/css.astro";
import JavaScript from "@/icons/javascript.astro";
import TypeScript from "@/icons/type.astro";
import React from "@/icons/react.astro";
import Node from "@/icons/node.astro";
import MySQL from "@/icons/sql.astro";
import Git from "@/icons/git.astro";
import GitHub from "@/icons/GitHub.astro";
import Tailwind from "@/icons/tailwind.astro";
import PHP from "@/icons/php.astro";
import Laravel from "@/icons/laravel.astro";
import NestJS from "@/icons/nestJS.astro";
import AstroJS from "@/icons/astroJS.astro";
import Tauri from "@/icons/tauri.astro";
import CSharp from "@/icons/cSharp.astro";
import Ubuntu from "@/icons/ubuntu.astro";
import Windows from "@/icons/windows.astro";
import Angular from "@/icons/angular.astro";
import Expo from "@/icons/expo.astro";
import WordPress from "@/icons/wordpress.astro";
import Office from "@/icons/office.astro";
import Bash from "@/icons/bash.astro";
import SQLite from "@/icons/sqlite.astro";
import PostgreSQL from "@/icons/postgresql.astro";
import { getCV } from "@cv";
import { useTranslations } from "@/i18n";

const { skills } = getCV(Astro.currentLocale);
const t = useTranslations(Astro.currentLocale);

const SKILLS_ICONS: Record<string, any> = {
  HTML,
  CSS,
  JavaScript,
  TypeScript,
  React,
  Node,
  MySQL,
  Git,
  GitHub,
  Tailwind,
  PHP,
  Laravel,
  NestJS,
  AstroJS,
  Tauri,
  "C#": CSharp,
  Ubuntu,
  Windows,
  Angular,
  Expo,
  WordPress,
  Office,
  Bash,
  SQLite,
  PostgreSQL
};
---

<Section title={t.skills}>
  <ul>
    {
      skills.map(({ name }) => {
        const Icon = SKILLS_ICONS[name];
        
        return (
          <li>
            {Icon && <Icon />} 
            <span>{name}</span>
          </li>
        );
      })
    }
  </ul>
</Section>

<style>
  ul {
    display: inline-flex;
    gap: 8px;
    flex-wrap: wrap;
  }

  li {
    align-items: center;
    background: var(--color-chip-bg);
    border-radius: 6px;
    color: var(--color-chip-text);
    display: flex;
    font-size: 0.8rem;
    font-weight: 500;
    gap: 4px;
    padding: 0.2rem 0.6rem;
    transition: all 0.2s ease;
    cursor: default;
  }
  
  li:hover {
    background: var(--color-chip-bg-hover);
    transform: translateY(-2px);
  }

  @media print {
    li {
      background: #fff;
      color: #000;
      border: 1px solid #ccc;
      -webkit-print-color-adjust: exact;
      print-color-adjust: exact;
    }
  }
</style>
