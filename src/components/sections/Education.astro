---
import Section from "../Section.astro";

import { getCV } from "@cv";
import { useTranslations } from "@/i18n";

const { education } = getCV(Astro.currentLocale);
const t = useTranslations(Astro.currentLocale);
---

<Section title={t.education}>
  <ul>
    {
      education.map(({ institution, startDate, endDate, area, studyType }) => {
        const startYear = new Date(startDate).getFullYear();
        const endYear = endDate != null ? new Date(endDate).getFullYear() : t.present;
        const years = startYear === endYear ? `${startYear}` : `${startYear} – ${endYear}`;

        return (
          <li>
            <article>
              <header>
                <div>
                  <h3>{institution}</h3>
                </div>

                <time>{years}</time>
              </header>

              <footer>
                <p>{studyType ? `${studyType} · ${area}` : area}</p>
              </footer>
            </article>
          </li>
        );
      })
    }
  </ul>
</Section>

<style>
  ul {
    display: flex;
    flex-direction: column;
    gap: 32px;
    position: relative;
    padding-left: 1.5rem;
  }

  ul::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 2px;
    background: var(--color-border);
  }

  li {
    position: relative;
  }

  li::before {
    content: '';
    position: absolute;
    left: -1.5rem;
    top: 0.5rem;
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--color-accent);
    border: 2px solid var(--color-bg);
    transform: translateX(-50%);
    z-index: 1;
  }

  article h3 {
    font-weight: 600;
    color: var(--color-heading);
    font-size: 1.1rem;
  }

  header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 4px;
  }

  time {
    color: var(--color-text-muted);
    font-size: 0.85rem;
    min-width: 102px;
    text-align: right;
  }
  
  p {
    color: var(--color-text-soft);
  }

  @media (width <= 700px) {
    time {
      text-align: right;
    }
    
    ul {
      padding-left: 0;
    }
    
    ul::before, li::before {
      display: none;
    }
  }

  @media print {
    ul::before, li::before {
      -webkit-print-color-adjust: exact;
      print-color-adjust: exact;
    }
  }
</style>
