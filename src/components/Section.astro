---
interface Props {
  title?: string;
}

const { title } = Astro.props;
---

<section>
  {title && <h2>{title}</h2>}
  <slot />
</section>

<style>
  section {
    max-width: 740px;
    margin: 0 auto 48px;
    animation: fadeIn 0.5s ease-in-out;
  }

  h2 {
    margin-bottom: 8px;
    font-weight: 700;
    line-height: 1.5;
    font-size: 1.5rem;
  }

  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(10px); }
    to { opacity: 1; transform: translateY(0); }
  }

  @media (width <= 700px) {
    section {
      margin-bottom: 38px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    section {
      animation: none;
    }
  }
</style>
